{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "comercialweb-mobile-api",
    "Audience": "comercialweb-mobile"
  },
  "Auth": {
    "LegacyPairing": true,
    "Personal": { "SessionDays": 180, "IdleDays": 30, "IdleLockSeconds": 300, "OfflineHours": 72 },
    "Shared": { "SessionHours": 12, "IdleMinutes": 30, "IdleLockSeconds": 120, "OfflineHours": 12 }
  }
}
