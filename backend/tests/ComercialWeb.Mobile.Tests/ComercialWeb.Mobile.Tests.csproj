<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- Nomes de teste em frase com underscore. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0-rc.1.26425.128" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ComercialWeb.Mobile.Api\ComercialWeb.Mobile.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\db\migrations\*.sql" LinkBase="migrations" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
