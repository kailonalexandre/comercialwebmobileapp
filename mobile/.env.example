# EXPO_PUBLIC_* é embutido no app no build: NUNCA coloque segredo aqui.
# O ambiente é fixado no build; o usuário final não escolhe. Detalhes: README.md, seção "Ambientes".

# --- LOCAL (desenvolvimento): copie para mobile/.env.local (ignorado pelo git) ---
EXPO_PUBLIC_APP_ENV=local
# API .NET do app. Emulador Android acessa o host por 10.0.2.2; aparelho real usa o IP da máquina na LAN.
EXPO_PUBLIC_API_URL=http://192.168.0.10:8080

# --- VPS (produção): defina no shell/CI ao gerar o build; nunca em .env.local ---
# EXPO_PUBLIC_APP_ENV=vps
# EXPO_PUBLIC_API_URL=https://api.meudominio.com.br
# Hosts aceitos no servidor do QR (o resto é recusado). `*.dominio` cobre subdomínios, não o domínio puro.
# EXPO_PUBLIC_ALLOWED_SERVER_HOSTS=app.meudominio.com.br,*.meudominio.com.br

# ComercialWeb web (links "Registre-se" e "Esqueceu sua senha?"). Vazio = links ocultos.
# EXPO_PUBLIC_WEB_URL=
