# Copie para mobile/.env.local (ignorado pelo git).
# EXPO_PUBLIC_* é embutido no app: NUNCA coloque segredo aqui.

# API do app. Vazio = sessão fictícia em desenvolvimento.
# Emulador Android acessa o host por 10.0.2.2. Fora de dev, exige https://
EXPO_PUBLIC_API_URL=

# ComercialWeb web (links "Registre-se" e "Esqueceu sua senha?"). Vazio = links ocultos.
EXPO_PUBLIC_WEB_URL=

# local | homologacao | producao (rótulo exibido no app; produção não mostra rótulo)
EXPO_PUBLIC_APP_ENV=local
