{
  "expo": {
    "name": "Infinit Comercial",
    "slug": "infinit-comercial",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.infinitsolucoesweb.comercial"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6D28D9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.com.infinitsolucoesweb.comercial",
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "A câmera é usada apenas para ler o QR Code de pareamento com o ComercialWeb.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "scheme": [
      "infinitcomercial",
      "comercialweb"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
