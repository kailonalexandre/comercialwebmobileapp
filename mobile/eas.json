{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_APP_ENV": "local" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_APP_ENV": "vps" }
    },
    "dev-vps": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "vps",
        "EXPO_PUBLIC_API_URL": "https://api.dev.infinitsolucoesweb.com.br/api",
        "EXPO_PUBLIC_ALLOWED_SERVER_HOSTS": "dev.infinitsolucoesweb.com.br",
        "GOOGLE_SERVICES_JSON": "./secrets/google-services.json"
      }
    },
    "production": {
      "env": { "EXPO_PUBLIC_APP_ENV": "vps" }
    }
  }
}
